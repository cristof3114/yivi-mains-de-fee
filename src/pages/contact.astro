---
import Base from '../layouts/Base.astro';
---
<Base title="Contact" description="Contacter Yivi mains de fée : question sur un sac, réservation, sur-mesure.">
  <section class="wrap section contact">
    <div class="contact-intro">
      <p class="etiquette">Contact</p>
      <h1>Écrire à Yivi</h1>
      <p class="lead">Une question sur un sac, une réservation, une idée de partenariat : Yivi répond elle-même, en général sous 48 heures.</p>
      <dl class="coord">
        <div><dt>E-mail</dt><dd>bonjour@yivi-mainsdefee.fr</dd></div>
        <div><dt>Instagram</dt><dd>@yivi_mdf</dd></div>
        <div><dt>TikTok</dt><dd>@yivi_mainsdefee</dd></div>
      </dl>
    </div>
    <form class="formulaire js-form" data-merci="Merci, votre message est bien parti. Yivi vous répond en général sous 48 heures.">
      <div class="champ"><label for="ct-nom">Prénom et nom</label><input id="ct-nom" name="nom" required autocomplete="name" /></div>
      <div class="champ"><label for="ct-email">E-mail</label><input id="ct-email" name="email" type="email" required autocomplete="email" /></div>
      <div class="champ"><label for="ct-sujet">Sujet</label><input id="ct-sujet" name="sujet" placeholder="par ex. Réserver le sac Lagon" /></div>
      <div class="champ"><label for="ct-message">Message</label><textarea id="ct-message" name="message" rows="6" required></textarea></div>
      <button class="btn" type="submit">Envoyer</button>
      <p class="form-retour" role="status"></p>
    </form>
  </section>
</Base>
<style>
  .contact { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .contact-intro { display: grid; gap: 1.25rem; min-width: 0; }
  .contact-intro h1 { font-size: var(--step-3); }
  .coord { margin: 0.5rem 0 0; display: grid; }
  .coord div { display: grid; grid-template-columns: 6.5rem 1fr; gap: 1rem; padding-block: 0.6rem; border-bottom: 1px dashed var(--line); }
  .coord dt { font-family: var(--mono); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); padding-top: 0.15rem; }
  .coord dd { margin: 0; overflow-wrap: anywhere; }
  .note { color: var(--muted); font-size: var(--step--1); }
  .formulaire { background: var(--surface); border-radius: var(--radius); padding: clamp(1.25rem, 4vw, 2.25rem); display: grid; gap: 1rem; min-width: 0; }
  .formulaire .btn { justify-self: start; }
  @media (max-width: 760px) { .contact { grid-template-columns: 1fr; } }
</style>
